# Copie para .env (no computador) ou cadastre no GitHub (Settings → Secrets and variables → Actions).
# Nenhuma é obrigatória: sem chaves, o app usa linha de referência + Kalshi (grátis, sem chave).

# The Odds API — https://the-odds-api.com (grátis: 500 créditos/mês)
ODDS_API_KEY=
# economico (só fechamento, 2 mercados: cabe no plano grátis) | padrao (abertura+fechamento, 4) | completo (8)
ODDS_MODE=padrao
# até 10 casas custam o mesmo que 1 região; "none" volta a usar ODDS_REGIONS
ODDS_BOOKMAKERS=
ODDS_REGIONS=us
# teto de créditos por mês (opcional); o coletor divide o que sobra pelos dias restantes
ODDS_MONTHLY_BUDGET=
# minutos antes do jogo em que vale a foto de fechamento
ODDS_CLOSE_WINDOW=150

# SportsGameOdds — https://sportsgameodds.com (grátis "Amateur": 2.500 objetos/mês)
SGO_API_KEY=
SGO_MAX_DAILY=4

# BALLDONTLIE — https://app.balldontlie.io (chave grátis). Reserva do calendário do dia se a NBA não responder.
BDL_API_KEY=

# Kalshi (bolsa, leitura pública, sem chave). 0 desliga.
KALSHI=1

# Resumo diário no Telegram (opcional): crie o bot com o @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_UTC_HOURS=21
APP_URL=

# Relatório oficial de lesões em PDF (precisa de pip install pypdf). 0 desliga.
OFFICIAL_INJURIES=1
CONCURRENCY=6

# Radar de divergência no Telegram a cada coleta (casa pagando acima do consenso das outras).
# Padrão 0.04 (4%). Use RADAR_MIN=off para desligar.
RADAR_MIN=0.04
